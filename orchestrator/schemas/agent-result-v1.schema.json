{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ensemble.agent-result/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "message_id",
    "state_version",
    "agent_id",
    "status",
    "summary",
    "vote",
    "hard_stop",
    "evidence",
    "files_read",
    "files_changed",
    "tests",
    "narrative_markdown",
    "started_at",
    "completed_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "pattern": "^TASK-[A-Za-z0-9._-]+$"},
    "message_id": {"type": "string", "minLength": 8},
    "state_version": {"type": "integer", "minimum": 1},
    "agent_id": {
      "enum": ["antigravity", "cursor", "claude", "codex-app"]
    },
    "status": {"enum": ["completed", "failed", "timed_out", "abstained"]},
    "summary": {"type": "string"},
    "vote": {"enum": ["APPROVE", "REVISE", "VETO", "ABSTAIN"]},
    "hard_stop": {
      "enum": [
        "NONE",
        "SECRET_OR_PII",
        "POLICY_VIOLATION",
        "FORBIDDEN_GPU",
        "DESTRUCTIVE",
        "EXTERNAL_SIDE_EFFECT",
        "STATE_CORRUPT",
        "DIRTY_BASE_CONFLICT",
        "LICENSE_RISK",
        "INTEGRITY_FAILURE",
        "ADAPTER_UNAVAILABLE"
      ]
    },
    "evidence": {"type": "array", "items": {"type": "string"}},
    "files_read": {"type": "array", "items": {"type": "string"}},
    "files_changed": {"type": "array", "items": {"type": "string"}},
    "tests": {"type": "array", "items": {"type": "string"}},
    "narrative_markdown": {"type": "string"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"}
  }
}
